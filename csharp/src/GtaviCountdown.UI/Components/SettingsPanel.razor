@implements IDisposable
@inject BrowserInterop Browser

<dialog @ref="_dialog" aria-labelledby="settings-title">
    <div class="sheet">
        <header>
            <h2 id="settings-title">Settings</h2>
            <button type="button" class="close" aria-label="Close settings" @onclick="CloseAsync">
                <Icon Name="IconName.Close" />
            </button>
        </header>

        <div class="body">
            <section>
                <h3 class="label">Release time zone</h3>
                <p class="note">
                    The game unlocks at midnight local time, so the moment depends on where you are. Zones
                    are listed in the order they reach it.
                </p>
                @if (Open)
                {
                    <ZonePicker Value="@Settings.TimeZone"
                                OnSelect="zone => Change(s => s with { TimeZone = zone })" />
                }
            </section>

            <section>
                <h3 class="label">Display</h3>
                <div class="field">
                    <span class="field-title" id="theme-label">Theme</span>
                    <div class="themes" role="radiogroup" aria-labelledby="theme-label">
                        @foreach (var theme in SettingsCodec.Themes)
                        {
                            var info = Themes.Info[theme];
                            <button @key="theme"
                                    type="button"
                                    class="theme"
                                    role="radio"
                                    aria-checked="@(Settings.Theme == theme ? "true" : "false")"
                                    @onclick="() => Change(s => s with { Theme = theme })">
                                <span class="swatch"
                                      style="background: linear-gradient(180deg, @info.Swatch[0], @info.Swatch[1] 55%, @info.Swatch[2])"></span>
                                @info.Label
                            </button>
                        }
                    </div>
                </div>

                <div class="field">
                    <span class="field-title" id="effects-label">Animated backdrop</span>
                    <div class="segmented" role="radiogroup" aria-labelledby="effects-label">
                        @foreach (var level in SettingsCodec.EffectLevels)
                        {
                            <button @key="level"
                                    type="button"
                                    role="radio"
                                    aria-checked="@(Settings.Effects == level ? "true" : "false")"
                                    @onclick="() => Change(s => s with { Effects = level })">
                                @level
                            </button>
                        }
                    </div>
                    <p class="note">
                        Auto lowers the rendering resolution when the frame rate drops. Off replaces the scene
                        with a still gradient.
                    </p>
                </div>

                <Switch Label="Milliseconds"
                        Hint="Adds a per-frame readout after the seconds."
                        Checked="Settings.ShowMilliseconds"
                        OnChange="value => Change(s => s with { ShowMilliseconds = value })" />
            </section>

            <section>
                <h3 class="label">Alerts</h3>
                <Switch Label="Notify me at release"
                        Hint="Shows a system notification when the countdown reaches zero while the app is open."
                        Checked="Settings.Notify"
                        OnChange="OnNotify" />
            </section>

            @if (IsDesktop)
            {
                <section>
                    <h3 class="label">Desktop</h3>
                    <Switch Label="Always on top"
                            Hint="Keeps the window above other windows."
                            Checked="Settings.AlwaysOnTop"
                            OnChange="value => Change(s => s with { AlwaysOnTop = value })" />
                    <Switch Label="Network time"
                            Hint="Corrects the system clock against an NTP server at start-up."
                            Checked="Settings.NetworkTime"
                            OnChange="value => Change(s => s with { NetworkTime = value })" />
                    <div class="sync">
                        <p class="note" aria-live="polite">@SyncText</p>
                        <button type="button"
                                class="button"
                                disabled="@(!Settings.NetworkTime || Sync is SyncState.Syncing)"
                                @onclick="OnSync">
                            <Icon Name="IconName.Sync" Size="15" />
                            Sync now
                        </button>
                    </div>
                </section>
            }

            @if (!IsTouch)
            {
                <section>
                    <h3 class="label">Keyboard shortcuts</h3>
                    <dl class="shortcuts">
                        @foreach (var (key, action) in Shortcuts)
                        {
                            <div @key="key">
                                <dt><kbd>@key</kbd></dt>
                                <dd>@action</dd>
                            </div>
                        }
                    </dl>
                </section>
            }

            <section class="reset">
                <button type="button" class="button" @onclick="() => Change(_ => SettingsData.Defaults)">
                    Restore defaults
                </button>
            </section>
        </div>
    </div>
</dialog>

@code {
    private static readonly (string Key, string Action)[] Shortcuts =
    [
        ("S", "Open or close settings"),
        ("F", "Toggle fullscreen"),
        ("M", "Toggle milliseconds"),
        ("T", "Next theme"),
        ("C", "Copy the countdown"),
        ("Esc", "Close settings"),
    ];

    private ElementReference _dialog;
    private DotNetObjectReference<SettingsPanel>? _self;
    private bool _shown;

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter, EditorRequired] public SettingsData Settings { get; set; } = SettingsData.Defaults;

    /// <summary>Receives a change to apply to the settings.</summary>
    [Parameter] public EventCallback<Func<SettingsData, SettingsData>> OnChange { get; set; }

    [Parameter, EditorRequired] public SyncState Sync { get; set; } = new SyncState.Idle();

    [Parameter] public EventCallback OnSync { get; set; }

    /// <summary>Called when the user flips notifications; the host asks for permission.</summary>
    [Parameter] public EventCallback<bool> OnNotify { get; set; }

    [Parameter] public bool IsDesktop { get; set; }

    [Parameter] public bool IsTouch { get; set; }

    private Task Change(Func<SettingsData, SettingsData> change) => OnChange.InvokeAsync(change);

    private string SyncText => Sync switch
    {
        SyncState.Syncing => "Measuring the clock offset.",
        SyncState.Ok ok => OkText(ok.Result),
        SyncState.Error error => $"Using the system clock. {error.Message}",
        _ => "Using the system clock.",
    };

    private static string OkText(TimeSyncResult result)
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var sign = result.OffsetMs >= 0 ? "+" : "-";
        var size = Math.Abs(result.OffsetMs);
        var amount = size >= 1000
            ? (size / 1000).ToString("F2", inv) + " s"
            : Math.Round(size, MidpointRounding.AwayFromZero).ToString(inv) + " ms";
        var roundTrip = Math.Round(result.RoundTripMs, MidpointRounding.AwayFromZero).ToString(inv);
        return $"Corrected by {sign}{amount} using {result.Server} (round trip {roundTrip} ms).";
    }

    private Task CloseAsync() => OpenChanged.InvokeAsync(false);

    /// <summary>The native dialog closed itself: Escape, or a click on the backdrop.</summary>
    [JSInvokable]
    public Task OnDialogClosed()
    {
        _shown = false;
        return Open ? OpenChanged.InvokeAsync(false) : Task.CompletedTask;
    }

    // The native dialog provides the focus trap, Escape handling and inert
    // background; this only mirrors the Open parameter onto it.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await Browser.InitDialogAsync(_dialog, _self);
        }
        if (Open != _shown)
        {
            _shown = Open;
            await Browser.SetDialogOpenAsync(_dialog, Open);
        }
    }

    public void Dispose() => _self?.Dispose();
}
