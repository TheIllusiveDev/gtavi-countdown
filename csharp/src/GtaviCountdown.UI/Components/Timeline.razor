@using System.Globalization
<section class="timeline" aria-label="Progress of the wait since the first trailer">
    <header>
        <span class="label">The wait since Trailer 1</span>
        <span class="percent"><strong>@Percent</strong>% over</span>
    </header>

    <div class="track"
         role="progressbar"
         aria-valuemin="0"
         aria-valuemax="100"
         aria-valuenow="@((int)Math.Floor(Progress * 100))"
         aria-label="Share of the wait that is over">
        <div class="fill" style="transform: scaleX(@Css(Progress))"></div>
        @foreach (var mark in Marks)
        {
            <span @key="mark.Date"
                  class="@(mark.First ? "mark first" : "mark")"
                  style="left: @Css(mark.Position * 100)%"
                  title="@($"{mark.DateText}: {mark.Detail}")"></span>
        }
        <span class="@(Progress >= 1 ? "mark end reached" : "mark end")" style="left: 100%"></span>
    </div>

    <ol class="legend">
        @foreach (var mark in Marks)
        {
            <li @key="mark.Date" class="@(mark.First ? "first" : null)" style="left: @Css(mark.Position * 100)%">
                <span class="legend-title">@mark.Title</span>
                <span class="legend-date">@mark.DateText</span>
            </li>
        }
        <li class="last" style="left: 100%">
            <span class="legend-title">Release</span>
            <span class="legend-date">@ReleaseDateText</span>
        </li>
    </ol>
</section>

@code {
    private sealed record Mark(string Date, string Title, string Detail, double Position, string DateText, bool First);

    private static readonly string ReleaseDateText = Wording.ShortDate(
        new DateTimeOffset(Release.Year, Release.Month, Release.Day, 12, 0, 0, TimeSpan.Zero).ToUnixTimeMilliseconds());

    [Parameter] public long Now { get; set; }

    [Parameter] public long Target { get; set; }

    private double Progress => Countdown.WaitProgress(Now, Target);

    /// <summary>Two decimals while counting; the bar itself moves about 0.1% per day.</summary>
    private string Percent => Progress >= 1
        ? "100"
        : (Math.Floor(Progress * 10000) / 100).ToString("F2", CultureInfo.InvariantCulture);

    private IReadOnlyList<Mark> Marks => Release.Milestones
        .Select((milestone, index) =>
        {
            var instant = Release.MilestoneInstant(milestone.Date);
            return new Mark(
                milestone.Date,
                milestone.Title,
                milestone.Detail,
                Countdown.TimelinePosition(instant, Target),
                Wording.ShortDate(instant),
                index == 0);
        })
        .ToList();

    private static string Css(double value) => value.ToString("0.####", CultureInfo.InvariantCulture);
}
