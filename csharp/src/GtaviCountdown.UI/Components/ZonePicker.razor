<div class="picker">
    <label class="search">
        <Icon Name="IconName.Search" Size="16" />
        <span class="visually-hidden">Filter time zones</span>
        <input type="search"
               placeholder="Search city, region or offset"
               @bind="_query"
               @bind:event="oninput"
               autocomplete="off"
               autocapitalize="off"
               spellcheck="false" />
    </label>

    <ul class="list" aria-label="Time zones">
        @if (string.IsNullOrWhiteSpace(_query))
        {
            <li>
                <button type="button"
                        class="option"
                        aria-pressed="@(Value is null ? "true" : "false")"
                        @onclick="() => OnSelect.InvokeAsync(null)">
                    <span class="name">
                        <span class="city">Follow this device</span>
                        <span class="region">@_systemEntry.City</span>
                    </span>
                    <span class="offset">@_systemEntry.OffsetText</span>
                </button>
            </li>
        }
        @{ var any = false; }
        @foreach (var zone in Matches())
        {
            any = true;
            <li @key="zone.Id">
                <button type="button"
                        class="option"
                        aria-pressed="@(Value == zone.Id ? "true" : "false")"
                        @onclick="() => OnSelect.InvokeAsync(zone.Id)">
                    <span class="name">
                        <span class="city">@zone.City</span>
                        @if (zone.Region.Length > 0)
                        {
                            <span class="region">@zone.Region</span>
                        }
                    </span>
                    <span class="offset">@zone.OffsetText</span>
                </button>
            </li>
        }
        @if (!any)
        {
            <li class="empty">No time zone matches "@_query.Trim()".</li>
        }
    </ul>
</div>

@code {
    /// <param name="Haystack">Lower-cased text the filter matches against.</param>
    private sealed record ZoneEntry(string Id, string City, string Region, long Offset, string OffsetText, string Haystack);

    // Offsets are evaluated at the release itself, not today, so that zones
    // which change their clocks before then are listed with the right value.
    private static readonly long Reference = Countdown.ReleaseInstant("UTC");

    // Built once. The zone furthest east unlocks first, so the list doubles as
    // the order in which the release moves around the planet.
    private static readonly Lazy<IReadOnlyList<ZoneEntry>> AllZones = new(() =>
        Zones.ListTimeZones()
            .Select(Entry)
            .OrderByDescending(zone => zone.Offset)
            .ThenBy(zone => zone.City, StringComparer.OrdinalIgnoreCase)
            .ToList());

    private readonly ZoneEntry _systemEntry = Entry(Zones.SystemTimeZone());
    private string _query = "";

    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> OnSelect { get; set; }

    private static ZoneEntry Entry(string id)
    {
        var offset = Zones.OffsetAt(Reference, id);
        var offsetText = Zones.FormatOffset(offset);
        var city = Zones.ZoneCity(id);
        var region = Zones.ZoneRegion(id);
        return new ZoneEntry(id, city, region, offset, offsetText, $"{id} {city} {region} {offsetText}".ToLowerInvariant());
    }

    private IEnumerable<ZoneEntry> Matches()
    {
        var needle = _query.Trim().ToLowerInvariant().Replace('_', ' ');
        if (needle.Length == 0) return AllZones.Value;
        var words = needle.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries);
        return AllZones.Value.Where(zone => words.All(zone.Haystack.Contains));
    }
}
