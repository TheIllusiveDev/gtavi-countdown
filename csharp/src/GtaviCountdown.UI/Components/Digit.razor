@* One figure of the countdown. A change rolls the old glyph out downwards
   while the new one rolls in from above; both run as CSS animations on the
   compositor, so a change costs no script time per frame. *@
<span class="cell" aria-hidden="true">
    @* Both glyphs come from this one loop: Blazor only matches @key among
       elements written at the same place in the markup, and the glyph that
       rolls in must stay the same element when it later rolls out. *@
    @foreach (var glyph in _glyphs)
    {
        <span @key="glyph.Id" class="@glyph.Class">@glyph.Value</span>
    }
</span>

@code {
    private sealed record Glyph(int Id, char Value, string Class);

    private Glyph[] _glyphs = [];
    private int _generation;

    [Parameter, EditorRequired] public char Value { get; set; }

    protected override void OnParametersSet()
    {
        if (_glyphs.Length == 0)
        {
            // The first value appears without animating, like a page load.
            _glyphs = [new Glyph(_generation, Value, "glyph")];
        }
        else if (Value != _glyphs[^1].Value)
        {
            var current = _glyphs[^1];
            _generation++;
            _glyphs =
            [
                current with { Class = "glyph out" },
                new Glyph(_generation, Value, "glyph in"),
            ];
        }
    }
}
