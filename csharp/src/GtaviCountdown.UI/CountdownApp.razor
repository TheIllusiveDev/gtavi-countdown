@implements IAsyncDisposable
@inject IPlatform Platform
@inject BrowserInterop Browser
@inject Clock Clock

@* Nothing renders until the stored settings are loaded, so the first frame
   already has the right theme; the host page paints the base colour meanwhile. *@
@if (_ready)
{
    var parts = Parts;
    var zoneText = ZoneText;
    var localEquivalent = LocalEquivalent;

    <Backdrop Theme="_settings.Theme" Effects="_settings.Effects" />

    <div class="shell">
        <header class="bar">
            <div class="brand">
                <img class="brand-mark" src="_content/GtaviCountdown.UI/favicon.svg" alt="" width="26" height="26" />
                <span class="brand-name">GTA VI</span>
                <span class="brand-sub">Countdown</span>
            </div>

            <nav class="tools" aria-label="Actions">
                <button type="button" class="tool" @onclick="OnCalendarAsync" title="Add to calendar">
                    <Icon Name="IconName.Calendar" />
                    <span class="visually-hidden">Add to calendar</span>
                </button>
                @if (_canShare)
                {
                    <button type="button" class="tool" @onclick="OnCopyAsync" title="Share the countdown">
                        <Icon Name="IconName.Share" />
                        <span class="visually-hidden">Share the countdown</span>
                    </button>
                }
                else
                {
                    <button type="button" class="tool" @onclick="OnCopyAsync" title="Copy the countdown (C)">
                        <Icon Name="IconName.Copy" />
                        <span class="visually-hidden">Copy the countdown</span>
                    </button>
                }
                @if (Platform.IsDesktop)
                {
                    <button type="button"
                            class="tool"
                            aria-pressed="@(_settings.AlwaysOnTop ? "true" : "false")"
                            @onclick="() => UpdateSettingsAsync(s => s with { AlwaysOnTop = !s.AlwaysOnTop })"
                            title="Always on top">
                        <Icon Name="IconName.Pin" />
                        <span class="visually-hidden">Always on top</span>
                    </button>
                }
                @if (_canFullscreen)
                {
                    <button type="button" class="tool" @onclick="OnFullscreenAsync" title="Toggle fullscreen (F)">
                        <Icon Name="@(_fullscreen ? IconName.Compress : IconName.Expand)" />
                        <span class="visually-hidden">Toggle fullscreen</span>
                    </button>
                }
                <button type="button"
                        class="tool"
                        aria-haspopup="dialog"
                        @onclick="() => _settingsOpen = true"
                        title="Settings (S)">
                    <Icon Name="IconName.Sliders" />
                    <span class="visually-hidden">Settings</span>
                </button>
            </nav>
        </header>

        <main>
            <div class="hero" @ref="_hero">
                <p class="@(parts.Elapsed ? "label eyebrow out" : "label eyebrow")">
                    @(parts.Elapsed ? "Out now" : "Countdown to")
                </p>
                <h1>@Release.Title</h1>

                <p class="when">
                    <span>@(parts.Elapsed ? "Released" : "Unlocks") @TargetDate at @TargetTime</span>
                    <button type="button"
                            class="zone"
                            @onclick="() => _settingsOpen = true"
                            title="Change the time zone">
                        @zoneText
                        <Icon Name="IconName.Chevron" Size="14" />
                    </button>
                </p>
                @if (localEquivalent.Length > 0)
                {
                    <p class="local">@localEquivalent on this device</p>
                }

                <div class="timer">
                    <CountdownDisplay Parts="parts"
                                      Target="_target"
                                      ShowMilliseconds="_settings.ShowMilliseconds"
                                      ClockOffset="Clock.Offset" />
                </div>
                @if (parts.Elapsed)
                {
                    <p class="label since">Since release</p>
                }
            </div>

            <div class="details" @ref="_details">
                <Timeline Now="Clock.Now" Target="_target" />
                @if (!parts.Elapsed)
                {
                    <Stats Now="Clock.Now" Target="_target" TimeZone="@_zone" />
                }
            </div>
        </main>

        <footer>
            <p>
                Unofficial fan project. Not affiliated with Rockstar Games or Take-Two Interactive. The
                unlock hour is as reported and may change.
            </p>
            <p class="clock-source">
                @(_sync switch
                {
                    SyncState.Ok => "Network time",
                    SyncState.Syncing => "Syncing clock",
                    _ => "System clock",
                })
            </p>
        </footer>
    </div>

    <SettingsPanel @bind-Open="_settingsOpen"
                   Settings="_settings"
                   OnChange="UpdateSettingsAsync"
                   Sync="_sync"
                   OnSync="RunSyncAsync"
                   OnNotify="SetNotifyAsync"
                   IsDesktop="Platform.IsDesktop"
                   IsTouch="_isTouch" />

    <div class="@(_toast.Length > 0 ? "toast visible" : "toast")" role="status" aria-live="polite">
        @_toast
    </div>
}
