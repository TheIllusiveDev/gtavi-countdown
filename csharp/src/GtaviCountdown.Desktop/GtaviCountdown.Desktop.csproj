<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>gtavi-countdown</AssemblyName>
    <RootNamespace>GtaviCountdown.Desktop</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>GTA VI Countdown</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
    <!-- Photino.Blazor targets .NET 9; align the web view host with .NET 10. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GtaviCountdown.UI\GtaviCountdown.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
